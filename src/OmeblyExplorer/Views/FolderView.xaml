<UserControl
    x:Class="OmeblyExplorer.Views.FolderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:OmeblyExplorer.Core"
    xmlns:views="using:OmeblyExplorer.Views">
    <UserControl.Resources>
        <!-- Details: each row is built in code from the chosen columns (FolderView.DetailsRow); this holds it. -->
        <DataTemplate x:Key="DetailsTemplate"><Border /></DataTemplate>
        <!-- Content: a row with a picture, the name and type, then the date and size -->
        <DataTemplate x:Key="ContentTemplate" x:DataType="core:FileItem">
            <Grid Height="62" ColumnSpacing="14" Opacity="{x:Bind views:Ui.HiddenOpacity(IsHidden)}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Width="40" Height="40" Stretch="Uniform" Data="{StaticResource FolderPath}" Fill="{x:Bind views:Ui.Brush(FolderFill)}" Visibility="{x:Bind views:Ui.Show(IsFolder)}" />
                <Image Width="48" Height="48" Source="{x:Bind Icon, Mode=OneWay}" Visibility="{x:Bind views:Ui.Hide(IsFolder)}" Stretch="Uniform" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind DisplayName}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind TypeText}" FontSize="12" Foreground="{ThemeResource OxMuted}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" MinWidth="170">
                    <TextBlock Text="{x:Bind ModifiedText}" FontSize="12" Foreground="{ThemeResource OxMuted}" />
                    <TextBlock Text="{x:Bind SizeText}" FontSize="12" Foreground="{ThemeResource OxMuted}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!-- Extra large icons -->
        <DataTemplate x:Key="XlTemplate" x:DataType="core:FileItem">
            <Grid Width="270" Height="300" Padding="6" RowSpacing="6" Opacity="{x:Bind views:Ui.HiddenOpacity(IsHidden)}">
                <Grid.RowDefinitions><RowDefinition Height="256" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Path Width="200" Height="200" Stretch="Uniform" Data="{StaticResource FolderPath}" Fill="{x:Bind views:Ui.Brush(FolderFill)}" Visibility="{x:Bind views:Ui.Show(IsFolder)}" />
                <Image Width="256" Height="256" Source="{x:Bind Icon, Mode=OneWay}" Visibility="{x:Bind views:Ui.Hide(IsFolder)}" Stretch="Uniform" />
                <TextBlock Grid.Row="1" Text="{x:Bind DisplayName}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="13" />
            </Grid>
        </DataTemplate>
        <!-- Large icons -->
        <DataTemplate x:Key="TileTemplate" x:DataType="core:FileItem">
            <Grid Width="130" Height="150" Padding="6" RowSpacing="6" Opacity="{x:Bind views:Ui.HiddenOpacity(IsHidden)}">
                <Grid.RowDefinitions><RowDefinition Height="96" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Path Width="80" Height="80" Stretch="Uniform" Data="{StaticResource FolderPath}" Fill="{x:Bind views:Ui.Brush(FolderFill)}" Visibility="{x:Bind views:Ui.Show(IsFolder)}" />
                <Image Width="96" Height="96" Source="{x:Bind Icon, Mode=OneWay}" Visibility="{x:Bind views:Ui.Hide(IsFolder)}" Stretch="Uniform" />
                <TextBlock Grid.Row="1" Text="{x:Bind DisplayName}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12.5" />
            </Grid>
        </DataTemplate>
        <!-- Medium icons -->
        <DataTemplate x:Key="MediumTemplate" x:DataType="core:FileItem">
            <Grid Width="100" Height="100" Padding="4" RowSpacing="4" Opacity="{x:Bind views:Ui.HiddenOpacity(IsHidden)}">
                <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Path Width="42" Height="42" Stretch="Uniform" Data="{StaticResource FolderPath}" Fill="{x:Bind views:Ui.Brush(FolderFill)}" Visibility="{x:Bind views:Ui.Show(IsFolder)}" />
                <Image Width="48" Height="48" Source="{x:Bind Icon, Mode=OneWay}" Visibility="{x:Bind views:Ui.Hide(IsFolder)}" Stretch="Uniform" />
                <TextBlock Grid.Row="1" Text="{x:Bind DisplayName}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12" />
            </Grid>
        </DataTemplate>
        <!-- Small icons and List: an icon and the name on one line -->
        <DataTemplate x:Key="SmallTemplate" x:DataType="core:FileItem">
            <Grid Width="240" Height="26" ColumnSpacing="8" Padding="4,0,4,0" Opacity="{x:Bind views:Ui.HiddenOpacity(IsHidden)}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Path Width="17" Height="17" Stretch="Uniform" Data="{StaticResource FolderPath}" Fill="{x:Bind views:Ui.Brush(FolderFill)}" Visibility="{x:Bind views:Ui.Show(IsFolder)}" VerticalAlignment="Center" />
                <Image Width="18" Height="18" Source="{x:Bind Icon, Mode=OneWay}" Visibility="{x:Bind views:Ui.Hide(IsFolder)}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12.5" />
            </Grid>
        </DataTemplate>
        <!-- Tiles: a medium picture with the name, type and size beside it -->
        <DataTemplate x:Key="TilesInfoTemplate" x:DataType="core:FileItem">
            <Grid Width="290" Height="64" ColumnSpacing="10" Padding="4" Opacity="{x:Bind views:Ui.HiddenOpacity(IsHidden)}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Path Width="42" Height="42" Stretch="Uniform" Data="{StaticResource FolderPath}" Fill="{x:Bind views:Ui.Brush(FolderFill)}" Visibility="{x:Bind views:Ui.Show(IsFolder)}" />
                <Image Width="48" Height="48" Source="{x:Bind Icon, Mode=OneWay}" Visibility="{x:Bind views:Ui.Hide(IsFolder)}" Stretch="Uniform" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{x:Bind DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind TypeText}" FontSize="12" Foreground="{ThemeResource OxMuted}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind SizeText}" FontSize="12" Foreground="{ThemeResource OxMuted}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!-- Gallery: big pictures for photos and videos -->
        <DataTemplate x:Key="GalleryTemplate" x:DataType="core:FileItem">
            <Grid Width="214" Height="200" RowSpacing="0" CornerRadius="12" Background="{ThemeResource OxCard}" BorderBrush="{ThemeResource OxLine}" BorderThickness="1" Opacity="{x:Bind views:Ui.HiddenOpacity(IsHidden)}">
                <Grid.RowDefinitions><RowDefinition Height="140" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="{ThemeResource OxCard2}" CornerRadius="11,11,0,0">
                    <Grid>
                        <Path Width="72" Height="72" Stretch="Uniform" Data="{StaticResource FolderPath}" Fill="{x:Bind views:Ui.Brush(FolderFill)}" Visibility="{x:Bind views:Ui.Show(IsFolder)}" />
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Visibility="{x:Bind views:Ui.Hide(IsFolder)}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Padding="12,8,12,8" Spacing="2">
                    <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind views:Ui.GallerySub(TypeText, SizeText)}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource OxMuted}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapAcross"><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="WrapDown"><ItemsWrapGrid Orientation="Vertical" /></ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" Background="Transparent" RightTapped="Background_RightTapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Column headers (details view): click to sort, drag the edges to resize, right-click to choose columns -->
        <Border x:Name="HeaderHost" BorderBrush="{ThemeResource OxLine}" BorderThickness="0,0,0,1" SizeChanged="HeaderHost_SizeChanged">
            <Grid x:Name="Header" AutomationProperties.AutomationId="ColumnHeaders" Height="34" Padding="18,0,30,0" HorizontalAlignment="Left" Background="Transparent" RightTapped="Header_RightTapped" />
        </Border>
        <ListView x:Name="List" ItemClick="Items_ItemClick" AutomationProperties.AutomationId="FileList" AutomationProperties.Name="Files" Grid.Row="1" SelectionMode="Extended" IsItemClickEnabled="False" CanDragItems="True" AllowDrop="True" Padding="10,4,10,10"
                  ItemTemplate="{StaticResource DetailsTemplate}" ContainerContentChanging="Items_ContainerContentChanging" DoubleTapped="Items_DoubleTapped"
                  RightTapped="Items_RightTapped" SelectionChanged="Items_SelectionChanged" DragItemsStarting="Items_DragItemsStarting" KeyDown="Items_KeyDown" CharacterReceived="Items_CharacterReceived" DragItemsCompleted="Items_DragItemsCompleted"
                  ChoosingGroupHeaderContainer="Items_ChoosingGroupHeader" DragOver="Item_DragOver" Drop="Item_Drop"
                  ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.IsHorizontalRailEnabled="True">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Padding" Value="8,0,8,0" />
                    <Setter Property="CornerRadius" Value="7" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True" />
            </ListView.GroupStyle>
        </ListView>
        <GridView x:Name="Tiles" ItemClick="Items_ItemClick" AutomationProperties.AutomationId="FileTiles" AutomationProperties.Name="Files" Grid.Row="1" Visibility="Collapsed" SelectionMode="Extended" CanDragItems="True" AllowDrop="True" Padding="16,10,16,16"
                  ItemTemplate="{StaticResource TileTemplate}" ContainerContentChanging="Items_ContainerContentChanging" DoubleTapped="Items_DoubleTapped"
                  RightTapped="Items_RightTapped" SelectionChanged="Items_SelectionChanged" DragItemsStarting="Items_DragItemsStarting" KeyDown="Items_KeyDown" CharacterReceived="Items_CharacterReceived" DragItemsCompleted="Items_DragItemsCompleted"
                  ChoosingGroupHeaderContainer="Items_ChoosingGroupHeader" DragOver="Item_DragOver" Drop="Item_Drop">
            <GridView.GroupStyle>
                <GroupStyle HidesIfEmpty="True" />
            </GridView.GroupStyle>
        </GridView>
        <StackPanel x:Name="Empty" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <Path Width="64" Height="64" Stretch="Uniform" Data="{StaticResource FolderPath}" Fill="{ThemeResource OxLine2}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyText" Text="This folder is empty" Foreground="{ThemeResource OxMuted}" HorizontalAlignment="Center" />
        </StackPanel>
        <ProgressBar x:Name="Loading" Grid.Row="1" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" Foreground="{ThemeResource OxAcc}" />
    </Grid>
</UserControl>
