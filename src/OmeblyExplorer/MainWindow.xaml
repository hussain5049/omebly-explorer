<Window
    x:Class="OmeblyExplorer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:OmeblyExplorer.Views"
    Title="Omebly Explorer">
    <Grid x:Name="Root" Background="{ThemeResource OxWin}" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Tabs, in the title bar, like a browser -->
        <Grid Grid.Row="0" Background="{ThemeResource OxStatus}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="TabStrip" AutomationProperties.AutomationId="TabStrip" Orientation="Horizontal" Spacing="4" Padding="10,8,0,0" />
            <Button x:Name="NewTabButton" AutomationProperties.AutomationId="NewTabButton" AutomationProperties.Name="New tab" Grid.Column="1" Style="{StaticResource OxIconButton}" Width="32" Height="30" Margin="4,7,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Content="&#xE710;" FontSize="12" ToolTipService.ToolTip="New tab (Ctrl+T)" Click="NewTab_Click" />
            <Border x:Name="DragArea" Grid.Column="1" Margin="44,0,0,0" Background="Transparent" />
        </Grid>

        <!-- Navigation, path, search, sort, views, New -->
        <Grid Grid.Row="1" Padding="10,8,12,8" ColumnSpacing="6" BorderBrush="{ThemeResource OxLine}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="BackButton" AutomationProperties.AutomationId="BackButton" AutomationProperties.Name="Back" Style="{StaticResource OxIconButton}" Content="&#xE72B;" ToolTipService.ToolTip="Back (Alt+Left), right-click for history" Click="Back_Click" RightTapped="History_RightTapped" />
                <Button x:Name="ForwardButton" AutomationProperties.AutomationId="ForwardButton" AutomationProperties.Name="Forward" Style="{StaticResource OxIconButton}" Content="&#xE72A;" ToolTipService.ToolTip="Forward (Alt+Right), right-click for history" Click="Forward_Click" RightTapped="History_RightTapped" />
                <Button x:Name="UpButton" AutomationProperties.AutomationId="UpButton" AutomationProperties.Name="Up" Style="{StaticResource OxIconButton}" Content="&#xE74A;" ToolTipService.ToolTip="Up one level (Alt+Up)" Click="Up_Click" />
                <Button Style="{StaticResource OxIconButton}" Content="&#xE72C;" AutomationProperties.AutomationId="RefreshButton" AutomationProperties.Name="Refresh" ToolTipService.ToolTip="Refresh (F5)" Click="Refresh_Click" />
            </StackPanel>

            <!-- Path bar: the breadcrumb; click empty space (or Ctrl+L) to type a path -->
            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Border x:Name="PathBox" Background="{ThemeResource OxCard}" BorderBrush="{ThemeResource OxLine}" BorderThickness="1" CornerRadius="9" Padding="10,0,6,0" Tapped="PathBox_Tapped">
                    <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Crumbs" AutomationProperties.AutomationId="Crumbs" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2" />
                    </ScrollViewer>
                </Border>
                <TextBox x:Name="PathEdit" AutomationProperties.AutomationId="PathEdit" AutomationProperties.Name="Path" Visibility="Collapsed" CornerRadius="9" VerticalContentAlignment="Center" KeyDown="PathEdit_KeyDown" LostFocus="PathEdit_LostFocus" PlaceholderText="Type a folder path" />
            </Grid>

            <Grid Grid.Column="2" Width="330">
                <TextBox x:Name="SearchBox" AutomationProperties.AutomationId="SearchBox" AutomationProperties.Name="Search" ToolTipService.ToolTip="Type to filter. Press Enter to search inside files too." CornerRadius="9" Padding="36,6,64,6" VerticalContentAlignment="Center" PlaceholderText="Search Home" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                <FontIcon FontFamily="{StaticResource OxIcons}" Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource OxMuted}" HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False" />
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Padding="7,2,7,2" CornerRadius="5" BorderBrush="{ThemeResource OxLine2}" BorderThickness="1" IsHitTestVisible="False">
                    <TextBlock Text="Ctrl F" FontFamily="Cascadia Mono,Consolas" FontSize="11" Foreground="{ThemeResource OxFaint}" />
                </Border>
            </Grid>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                <Button x:Name="SortButton" AutomationProperties.AutomationId="SortButton" AutomationProperties.Name="Sort" Style="{StaticResource OxIconButton}" Content="&#xE8CB;" ToolTipService.ToolTip="Sort">
                    <Button.Flyout>
                        <MenuFlyout x:Name="SortMenu" />
                    </Button.Flyout>
                </Button>
                <Border Background="{ThemeResource OxCard}" BorderBrush="{ThemeResource OxLine}" BorderThickness="1" CornerRadius="9" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="ViewDetails" AutomationProperties.AutomationId="ViewDetails" AutomationProperties.Name="Details view" Width="34" Height="28" Padding="0" CornerRadius="7" BorderThickness="0" FontFamily="{StaticResource OxIcons}" FontSize="14" Content="&#xE8FD;" ToolTipService.ToolTip="Details" Click="View_Click" Tag="details" />
                        <ToggleButton x:Name="ViewTiles" AutomationProperties.AutomationId="ViewTiles" AutomationProperties.Name="Large icons view" Width="34" Height="28" Padding="0" CornerRadius="7" BorderThickness="0" FontFamily="{StaticResource OxIcons}" FontSize="14" Content="&#xF0E2;" ToolTipService.ToolTip="Large icons" Click="View_Click" Tag="tiles" />
                        <ToggleButton x:Name="ViewGallery" AutomationProperties.AutomationId="ViewGallery" AutomationProperties.Name="Gallery view" Width="34" Height="28" Padding="0" CornerRadius="7" BorderThickness="0" FontFamily="{StaticResource OxIcons}" FontSize="14" Content="&#xE8B9;" ToolTipService.ToolTip="Gallery" Click="View_Click" Tag="gallery" />
                        <Button x:Name="ViewMore" AutomationProperties.AutomationId="ViewMore" AutomationProperties.Name="All views" Width="26" Height="28" Padding="0" CornerRadius="7" BorderThickness="0" Background="Transparent" FontFamily="{StaticResource OxIcons}" FontSize="10" Content="&#xE70D;" ToolTipService.ToolTip="All views, group by">
                            <Button.Flyout><MenuFlyout x:Name="ViewMenu" /></Button.Flyout>
                        </Button>
                    </StackPanel>
                </Border>
                <Button x:Name="NewButton" AutomationProperties.AutomationId="NewButton" AutomationProperties.Name="New" Height="36" CornerRadius="9" Padding="14,0,16,0" Background="{ThemeResource OxAcc}" Foreground="{ThemeResource OxAccText}" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource OxIcons}" Glyph="&#xE710;" FontSize="13" />
                        <TextBlock Text="New" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="NewMenu" Opening="NewMenu_Opening">
                            <MenuFlyoutItem Text="Folder" Click="NewFolder_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Text document" Click="NewText_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="New tab" Click="NewTab_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE737;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="New window" Click="NewWindow_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE78B;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Style="{StaticResource OxIconButton}" Content="&#xE712;" AutomationProperties.AutomationId="MoreButton" AutomationProperties.Name="More" ToolTipService.ToolTip="More">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="UndoItem" Text="Undo" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+Z" Click="Undo_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="RedoItem" Text="Redo" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+Y" Click="Redo_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A6;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Select all" KeyboardAcceleratorTextOverride="Ctrl+A" Click="SelectAll_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B3;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Select none" Click="SelectNone_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E6;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Invert selection" Click="Invert_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="HiddenToggle" Text="Show hidden files" Click="HiddenToggle_Click" />
                            <ToggleMenuFlyoutItem x:Name="ExtToggle" Text="Show file extensions" Click="ExtToggle_Click" />
                            <MenuFlyoutSubItem Text="Theme">
                                <RadioMenuFlyoutItem x:Name="ThemeGlass" Text="Omebly Glass" GroupName="theme" Click="Theme_Click" Tag="glass" />
                                <RadioMenuFlyoutItem x:Name="ThemeLight" Text="Windows Light" GroupName="theme" Click="Theme_Click" Tag="light" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Tools" Click="Tools_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE90F;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Folder options…" Click="FolderOptions_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Open in Windows Explorer" Click="OpenInExplorer_Click" />
                            <MenuFlyoutItem Text="Open terminal here" Click="Terminal_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="About Omebly Explorer" Click="About_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Sidebar and the main area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="258" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{ThemeResource OxSide}" BorderBrush="{ThemeResource OxLine}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8,8,10">
                    <StackPanel x:Name="Sidebar" Spacing="2" />
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <views:HomeView x:Name="Home" />
                <views:FolderView x:Name="Folder" Visibility="Collapsed" />
                <views:RecycleView x:Name="Bin" Visibility="Collapsed" />
                <views:ArchiveView x:Name="Arc" Visibility="Collapsed" />
                <views:ToolsView x:Name="Tools" Visibility="Collapsed" />
                <views:BrowseView x:Name="Browse" Visibility="Collapsed" />
                <views:SidePane x:Name="Pane" Grid.Column="1" />
                <!-- Copy and move cards, bottom right; they never block the window -->
                <StackPanel x:Name="Cards" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,18" Spacing="10" />
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="3" Padding="14,0,14,0" Background="{ThemeResource OxStatus}" BorderBrush="{ThemeResource OxLine}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusLeft" AutomationProperties.AutomationId="StatusLeft" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource OxMuted}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="7" Height="7" Fill="{ThemeResource OxAcc}" VerticalAlignment="Center" />
                    <TextBlock Text="Everything stays on this PC" FontSize="12" Foreground="{ThemeResource OxAcc}" />
                </StackPanel>
                <StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="8" />
                <TextBlock x:Name="StatusRight" FontSize="12" Foreground="{ThemeResource OxMuted}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
